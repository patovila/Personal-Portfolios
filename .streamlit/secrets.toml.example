# Copiá este archivo como .streamlit/secrets.toml y completá los valores.
# secrets.toml NUNCA va al repo (está en .gitignore).
# En Streamlit Cloud: Settings → Secrets (pegar el contenido sin el .example).

# Opcional: API key de Finnhub para calendario de earnings en tiempo real.
# Gratis en https://finnhub.io — sin esto, la app usa yfinance como fallback.
# FINNHUB_API_KEY = "tu_api_key_aqui"
